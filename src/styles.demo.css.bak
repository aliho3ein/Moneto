:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #25333d;
  background: #f4fff9;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --bg: #f4fff9;
  --card: #ffffff;
  --ink: #25333d;
  --muted: #7f8d8b;
  --line: #dce9e3;
  --mint: #9dd7c8;
  --mint-deep: #5d9e91;
  --pink: #f08ab7;
  --shadow: 0 16px 45px rgba(57, 85, 76, 0.08);
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 1100px; background: var(--bg); }
button, input { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible { outline: 3px solid rgba(93, 158, 145, .22); outline-offset: 2px; }

.app-shell { min-height: 100vh; display: flex; }
.sidebar {
  width: 250px; min-height: 100vh; background: #fff; border-right: 1px solid var(--line);
  display: flex; flex-direction: column; padding: 28px 18px;
  position: sticky; top: 0; height: 100vh;
}
.brand { font-size: 28px; font-weight: 800; letter-spacing: -1.3px; padding: 0 12px 34px; color: #29353d; }
.brand span, .login-brand span, .mobile-brand span { color: #e98bb4; }
.sidebar nav { display: grid; gap: 7px; }
.nav-item {
  border: 0; background: transparent; color: #7c8987; padding: 13px 14px; border-radius: 13px;
  display: flex; gap: 12px; align-items: center; font-weight: 650; text-align: left;
}
.nav-item:hover { background: #f3faf7; color: var(--ink); }
.nav-item.active { background: #eaf8f3; color: #4c897d; }
.nav-icon { font-size: 23px; line-height: 1; }
.sidebar-bottom { margin-top: auto; border-top: 1px solid var(--line); padding-top: 18px; }
.sidebar-user { display: flex; gap: 10px; align-items: center; padding: 8px 8px 14px; }
.sidebar-user strong { display: block; font-size: 13px; }
.sidebar-user span { color: var(--muted); font-size: 11px; }
.avatar, .top-avatar {
  display: grid; place-items: center; border-radius: 50%; background: #e9f7f2; color: #5d9e91;
}
.avatar { width: 35px; height: 35px; font-size: 11px; font-weight: 800; }
.logout-button {
  border: 0; background: transparent; color: #9b8e91; padding: 10px 8px; display: flex; gap: 9px;
  align-items: center; font-size: 13px;
}

.main-area { flex: 1; min-width: 0; }
.topbar {
  height: 94px; background: rgba(244,255,249,.92); backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(220,233,227,.7); padding: 0 44px;
  display: flex; align-items: center; justify-content: space-between;
}
.topbar-kicker, .eyebrow { font-size: 10px; letter-spacing: 1.6px; font-weight: 800; color: #8aa09a; }
.topbar h1 { margin: 5px 0 0; font-size: 23px; letter-spacing: -.5px; }
.topbar-right { display: flex; gap: 18px; align-items: center; }
.period { font-size: 13px; color: #73827f; }
.top-avatar { width: 40px; height: 40px; }
.mobile-menu { display: none; }

.page-content { padding: 34px 44px 60px; max-width: 1500px; margin: 0 auto; }
.summary-grid { display: grid; grid-template-columns: 1.15fr 1fr 1fr; gap: 16px; margin-bottom: 20px; }
.summary-card {
  background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 21px 23px; box-shadow: var(--shadow);
}
.summary-card.primary { background: #eaf8f3; border-color: #d3eee6; }
.summary-card span { color: #7e8e8a; font-size: 12px; display: block; }
.summary-card strong { display: block; font-size: 28px; margin: 6px 0 3px; letter-spacing: -1px; }
.summary-card small { color: #91a09d; font-size: 11px; }
.positive { color: #579b8b; }
.negative { color: #e57979; }

.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(330px, .9fr); gap: 20px; }
.chart-card, .categories-card, .recent-card, .settings-card, .editor-card, .settings-tip, .developer-card, .expense-form-card, .expense-list-card {
  background: #fff; border: 1px solid var(--line); border-radius: 22px; box-shadow: var(--shadow);
}
.chart-card, .categories-card, .recent-card { padding: 27px; }
.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.card-heading h2, .card-heading h3 { margin: 6px 0 0; font-size: 19px; letter-spacing: -.4px; }
.ghost-button, .secondary-button {
  border: 1px solid var(--line); background: #fff; color: #657572; border-radius: 10px; padding: 9px 12px;
  display: inline-flex; gap: 7px; align-items: center; font-weight: 650; font-size: 12px;
}
.ghost-button:hover, .secondary-button:hover { background: #f6fbf9; }
/* Donut chart: an SVG so each slice can anchor its own leader line. */
.donut-figure { margin-top: 16px; display: flex; flex-direction: column; align-items: center; }
.donut-svg { display: block; width: 100%; max-width: 760px; height: auto; overflow: visible; }
.donut-figure.is-compact .donut-svg { max-width: 380px; }

.donut-seg { cursor: pointer; }
.donut-seg:focus { outline: none; }
.donut-seg:focus-visible .donut-chip { stroke: #4c897d; stroke-width: 2.5; }
.donut-slice { stroke: #fff; stroke-width: 2; }
.donut-leader { fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; transition: stroke .16s ease; }
.donut-chip { stroke-width: 1.5; transition: stroke .16s ease; }
.donut-seg { transition: opacity .16s ease; }
.donut-seg.is-dimmed { opacity: .34; }

.donut-label-name { font-size: 13px; font-weight: 700; fill: #33423e; }
.donut-label-value { font-size: 11.5px; font-weight: 600; fill: #7f8d8a; }
.donut-center-label { font-size: 10px; font-weight: 700; letter-spacing: .9px; fill: #8a9894; }
.donut-center-value { font-size: 21px; font-weight: 800; letter-spacing: -.6px; fill: #2c3a35; }
.donut-center-value.is-negative { fill: #e57979; }
.donut-center-sub { font-size: 10.5px; font-weight: 600; fill: #9aa8a4; }
.donut-empty { text-align: center; margin: 2px 0 6px; }

/* Small screens drop the text labels, so the names live in this key. */
.donut-key {
  list-style: none; margin: 10px 0 0; padding: 0; width: 100%; max-width: 380px;
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3px;
}
.donut-key button {
  width: 100%; border: 0; background: transparent; display: grid;
  grid-template-columns: 9px minmax(0, 1fr); gap: 9px; align-items: center;
  padding: 8px 6px; border-radius: 10px; text-align: left;
}
.donut-key button:hover { background: #f6fbf9; }
.donut-key-dot { width: 9px; height: 9px; border-radius: 50%; }
.donut-key-name { font-size: 12px; color: #62716e; }
.donut-key-value { grid-column: 2; font-size: 12px; font-weight: 800; color: #35433f; }

.category-list { margin-top: 18px; display: grid; gap: 5px; }
.category-row {
  width: 100%; border: 0; background: transparent; display: grid; grid-template-columns: 42px 1fr 20px;
  align-items: center; gap: 11px; padding: 9px 5px; border-radius: 12px; text-align: left;
}
.category-row:hover { background: #f7fbf9; }
.category-icon, .expense-icon, .category-hero-icon {
  display: grid; place-items: center; border-radius: 12px;
}
.category-icon { width: 42px; height: 42px; }
.category-meta > div:first-child { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 7px; }
.category-meta strong { font-size: 12px; }
.category-meta span { font-size: 12px; color: #7f8c89; }
.progress { height: 5px; background: #edf3f0; border-radius: 99px; overflow: hidden; }
.progress span { display: block; height: 100%; border-radius: inherit; }
.row-chevron { color: #a6b1ae; }

.recent-card { margin-top: 20px; }
.expense-table { margin-top: 14px; }
.expense-row { display: grid; grid-template-columns: 42px 1fr auto; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid #eef3f1; }
.expense-row:last-child { border-bottom: 0; }
.expense-icon { width: 40px; height: 40px; background: #f6fbf9; }
.expense-info strong { display: block; font-size: 13px; }
.expense-info span { display: block; color: #899592; font-size: 11px; margin-top: 3px; }
.expense-amount { font-size: 13px; }

.settings-intro { display: flex; align-items: end; justify-content: space-between; gap: 30px; margin-bottom: 22px; }
.settings-intro h2 { margin: 7px 0 6px; font-size: 26px; letter-spacing: -.7px; }
.settings-intro p { max-width: 650px; margin: 0; line-height: 1.55; font-size: 13px; }
.settings-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(320px, .7fr); gap: 20px; }
.settings-card { padding: 9px; }
.settings-category { display: flex; align-items: center; justify-content: space-between; padding: 9px; border-bottom: 1px solid #edf3f1; }
.settings-category:last-child { border-bottom: 0; }
.settings-category-main { flex: 1; border: 0; background: transparent; display: flex; gap: 12px; align-items: center; text-align: left; }
.settings-category-main strong { display: block; font-size: 13px; }
.settings-category-main span { display: block; font-size: 11px; color: #8a9794; margin-top: 3px; }
.settings-actions { display: flex; gap: 5px; }
.icon-button { width: 34px; height: 34px; border: 0; background: transparent; color: #8a9895; border-radius: 9px; display: grid; place-items: center; }
.icon-button:hover { background: #eef7f3; color: #578f84; }
.icon-button.danger:hover { background: #fff1f1; color: #d86e6e; }
.editor-card, .settings-tip { padding: 25px; }
.editor-card h3, .settings-tip h3 { margin: 7px 0 22px; font-size: 20px; }
.settings-tip { color: #71817d; }
.settings-tip > svg { color: #70b0a0; }
.settings-tip p { font-size: 13px; line-height: 1.6; }
.editor-card label, .expense-form-card label {
  display: grid; gap: 7px; color: #667572; font-size: 12px; font-weight: 700; margin-bottom: 17px;
}
input {
  width: 100%; border: 1px solid #dce8e3; border-radius: 11px; background: #fbfefd;
  padding: 12px 13px; color: #29363d; font-size: 13px;
}
input:focus { border-color: #9acfc2; background: #fff; }
.icon-picker, .color-picker { display: flex; gap: 7px; flex-wrap: wrap; }
.icon-choice {
  width: 40px; height: 40px; border: 1px solid var(--line); background: #fff; color: #80908b; border-radius: 10px;
  display: grid; place-items: center;
}
.icon-choice.selected { border-color: #77b5a7; background: #eaf8f3; color: #4f8f81; }
.color-choice { width: 26px; height: 26px; border: 3px solid #fff; border-radius: 50%; box-shadow: 0 0 0 1px #dbe7e2; }
.color-choice.selected { box-shadow: 0 0 0 2px #557f77; }
.editor-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 25px; }
.primary-button {
  border: 0; background: #5d9e91; color: #fff; border-radius: 11px; padding: 12px 17px;
  display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 750; font-size: 13px;
  box-shadow: 0 8px 20px rgba(93,158,145,.17);
}
.primary-button:hover { background: #518e82; transform: translateY(-1px); }
.primary-button.compact { padding: 11px 15px; }
.developer-card { margin-top: 20px; padding: 18px 20px; display: flex; align-items: center; justify-content: space-between; gap: 15px; }
.developer-card strong, .developer-card span { display: block; }
.developer-card strong { font-size: 12px; }
.developer-card span { color: #8a9794; font-size: 11px; margin-top: 4px; }

.back-button { border: 0; background: transparent; color: #6c7c78; display: inline-flex; gap: 7px; align-items: center; font-weight: 700; font-size: 12px; padding: 0; margin-bottom: 24px; }
.category-hero { display: flex; align-items: center; gap: 17px; margin-bottom: 23px; }
.category-hero-icon { width: 62px; height: 62px; border-radius: 18px; }
.category-hero h2 { margin: 5px 0 3px; font-size: 28px; letter-spacing: -.8px; }
.category-hero p { margin: 0; color: #899592; font-size: 12px; }
.category-layout { display: grid; grid-template-columns: minmax(320px, .65fr) minmax(0, 1.35fr); gap: 20px; }
.expense-form-card, .expense-list-card { padding: 26px; }
.expense-form-card h3, .expense-list-card h3 { margin: 6px 0 24px; font-size: 19px; }
.money-input { position: relative; }
.money-input input { padding-right: 40px; font-size: 21px; font-weight: 750; }
.money-input span { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: #889692; font-weight: 700; }
.primary-button.full { width: 100%; margin-top: 5px; }
.form-note { font-size: 10px; color: #a0aaa7; line-height: 1.5; margin: 11px 0 0; text-align: center; }
.empty-state { padding: 45px 20px; text-align: center; color: #8c9895; font-size: 13px; }
.compact-empty { padding: 60px 10px; }

.login-page { min-height: 100vh; display: grid; grid-template-columns: 1.05fr .95fr; background: #fff; }
.login-visual { background: #eaf8f3; padding: 42px 55px; position: relative; overflow: hidden; }
.login-brand { font-size: 30px; font-weight: 800; letter-spacing: -1.4px; color: #29353d; }
.login-visual-copy { position: absolute; left: 55px; top: 27%; }
.login-visual-copy p { color: #679b8e; font-size: 13px; letter-spacing: 1px; text-transform: uppercase; font-weight: 750; }
.login-visual-copy h1 { font-size: clamp(48px, 6vw, 78px); line-height: .98; letter-spacing: -4px; margin: 16px 0; color: #32423f; }
.mini-donut { width: 280px; height: 280px; border-radius: 50%; background: conic-gradient(#f08ab7 0 45%, #7e8da3 45% 74%, #b36bc9 74% 88%, #9dd7c8 88% 100%); display: grid; place-items: center; box-shadow: 0 25px 50px rgba(72, 122, 109, .12); }
.mini-donut::after { content: ""; position: absolute; width: 150px; height: 150px; background: #eaf8f3; border-radius: 50%; }
.mini-donut-hole { z-index: 1; color: #5e8f84; font-weight: 800; font-size: 18px; }
.login-panel { display: grid; place-items: center; padding: 40px; }
.login-card { width: min(430px, 100%); }
.mobile-brand { display: none; font-size: 27px; font-weight: 800; letter-spacing: -1px; margin-bottom: 55px; }
.login-card h2 { margin: 9px 0 7px; font-size: 34px; letter-spacing: -1.1px; }
.muted { color: #8a9794; }
.login-card > .muted { font-size: 13px; margin: 0 0 30px; }
.form-stack label { display: grid; gap: 8px; font-size: 12px; color: #657470; font-weight: 750; margin-bottom: 17px; }
.form-stack input { padding: 14px; }
.error-message { background: #fff1f1; color: #b95d5d; border-radius: 10px; padding: 10px 12px; font-size: 12px; margin: -4px 0 15px; }
.form-stack .primary-button { width: 100%; padding: 14px; margin-top: 4px; }
.demo-note { margin-top: 20px; text-align: center; color: #9ba6a3; font-size: 10px; }

@media (max-width: 1250px) {
  .page-content { padding-left: 28px; padding-right: 28px; }
  .topbar { padding: 0 28px; }
  .sidebar { width: 220px; }
}

@media (max-width: 980px) {
  body { min-width: 0; }
  .sidebar { display: none; }
  .topbar { padding: 0 20px; height: 80px; }
  .mobile-menu { display: block; margin-right: 13px; }
  .topbar > div:first-of-type { display: flex; align-items: center; }
  .page-content { padding: 24px 20px 45px; }
  /* Budget / Ausgaben / Kontostand are hidden on small screens - the balance
     is in the middle of the donut and the rest is a tap away. */
  .summary-grid { display: none; }
  .dashboard-grid, .settings-grid, .category-layout { grid-template-columns: 1fr; }
  .login-page { grid-template-columns: 1fr; }
  .login-visual { display: none; }
  .mobile-brand { display: block; }
  .login-panel { min-height: 100vh; }
}
/* Google is the only sign-in method, so its button carries the whole form. */
.google-button {
  width: 100%; border: 1px solid #dbe6e2; background: #fff; color: #3c4a46; border-radius: 12px;
  padding: 15px 18px; display: inline-flex; align-items: center; justify-content: center; gap: 12px;
  font-weight: 700; font-size: 14px; box-shadow: 0 8px 20px rgba(57, 85, 76, .07);
}
.google-button:hover:not(:disabled) { background: #f8fbfa; border-color: #c7dad4; transform: translateY(-1px); }
.google-button:disabled { cursor: progress; color: #8d9a96; }
.google-mark { width: 19px; height: 19px; flex: none; }
.demo-note { line-height: 1.6; }

/* Firebase restores the session asynchronously - this covers that moment. */
.auth-splash { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 10px; }
.auth-splash .brand { padding: 0; }
.auth-splash p { margin: 0; color: var(--muted); font-size: 13px; }

.avatar-photo { object-fit: cover; }
.sidebar-user-text { min-width: 0; }
.sidebar-user-text strong, .sidebar-user-text span {
  display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
